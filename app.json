{
  "expo": {
    "name": "crew",
    "slug": "crew",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CREW utilise ta position pour te montrer les professionnels et collaborations à proximité."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CREW utilise ta position pour te montrer les professionnels et collaborations à proximité."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CREW a besoin d'accéder à tes photos pour ta photo de profil et ton portfolio."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF5A36"
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker"
    ]
  }
}
