# Copy this file to .env and fill in your Supabase project's values.
# Found in Supabase dashboard > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Free key from https://developer.tomtom.com/ (Maps Display API) — used for the live map on the Carte tab.
EXPO_PUBLIC_TOMTOM_API_KEY=your-tomtom-api-key
